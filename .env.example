# Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키 (REST/Admin 키 사용 금지)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# 실제 HTTPS 배포 주소. 비워 두면 접속한 origin을 사용합니다.
NEXT_PUBLIC_SITE_URL=

# 백엔드 연동 (docs/BACKEND_INTEGRATION.md). 둘 다 비우면 지금처럼 데모로 동작합니다.
# 백엔드 주소 (서버 전용, 브라우저에 노출되지 않음). 예: http://localhost:8080
BACKEND_ORIGIN=
# true면 로그인·결제·보관함·환불이 실제 서버를 사용합니다. 변경 후 다시 빌드해야 합니다.
NEXT_PUBLIC_USE_BACKEND=

# 결제 화면에 보여줄 결제 수단. 백엔드 PAYAPP_METHODS와 같은 값으로 맞추세요 (CARD, KAKAO, TOSS 쉼표 구분).
# 비우면 CARD만 보입니다. 데모 모드(USE_BACKEND 꺼짐)에서는 무시하고 세 가지 모두 보입니다. 변경 후 다시 빌드해야 합니다.
NEXT_PUBLIC_PAY_METHODS=

# 이용권 코드 (서버 전용, 브라우저에 노출되지 않음). 쉼표로 여러 개. 대소문자·공백·하이픈은 무시합니다.
# 주문/결제(7-3)의 "이용권 코드가 있어요"에 입력하면 그 기기에서 유료 결과 3종이 모두 열립니다.
# 10자 이상 무작위 문자열을 쓰세요. 지운 코드는 다음 앱 실행 때 다시 잠깁니다. 예: UNLOCK_CODES=YHD-TEAM-8K2Q9,YHD-JUDGE-4MZ7P
UNLOCK_CODES=

# Google Analytics 4 측정 ID (G-XXXXXXXXXX). 비워 두면 GA를 불러오지 않습니다.
NEXT_PUBLIC_GA_ID=
